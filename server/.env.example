# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/bbt_billing

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=3m
ADMIN_PIN=1234
ENCRYPTION_KEY=12345678901234567890123456789012

# Frontend links used in notification emails
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bit-byte/quotation-attachments

# Mail / SMTP
# Leave MAIL_HOST empty to skip sending emails in local development.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Bit Byte Technologies <no-reply@bitbytetech.com>"

# Seed users
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@bitbytetech.com
SEED_ADMIN_PHONE=1234567890
SEED_ADMIN_PASSWORD=Admin@123

SEED_ACCOUNTANT_NAME=Default Accountant
SEED_ACCOUNTANT_EMAIL=accountant@bitbytetech.com
SEED_ACCOUNTANT_PHONE=9876543210
SEED_ACCOUNTANT_PASSWORD=Account@123

# Google Sheet service pricing sync
# Production/Render recommended: paste base64 of the Google service account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Local-only alternative: keep the downloaded JSON outside git and point to it.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=.secrets/google-service-account.json
GOOGLE_SERVICE_PRICING_SPREADSHEET_ID=
GOOGLE_SERVICE_PRICING_SHEET_NAME=Sheet1

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
